{
  "manifest_version": 3,
  "name": "Zap",
  "description": "Boost any page: zap intrusive elements, recolor, swap fonts, or edit fixed text, all saved per-site.",
  "version": "0.1.0",
  "permissions": ["storage", "scripting", "tabs"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Zap",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["assets/content.js"],
      "run_at": "document_start"
    }
  ]
}
